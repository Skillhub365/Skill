# SkillTrack Labs — example environment. Placeholders only; never commit real values.
# Legend: [local] local dev only · [staging] · [prod] required in production
#         [vault] the value should live in Azure Key Vault in staging/production

# ---------------------------------------------------------------- platform ---
SKILLTRACK_ENV=development                 # development | staging | production [all]
NODE_ENV=development
SESSION_SIGNING_KEY=                       # [prod][vault] 64+ random chars; ephemeral locally
ALLOW_MOCK_FALLBACK=false                  # [local] emergency only; degrades live infra to mocks

# ---------------------------------------------------------------- supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co            # [all] public
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx         # [all] public
SUPABASE_URL=https://your-project.supabase.co                 # [all] server
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx              # [all] server
SUPABASE_SERVICE_ROLE_KEY=                                    # [prod][vault] server-only, bypasses RLS
DATABASE_URL=                                                 # [vault] optional direct Postgres URL

# ------------------------------------------------------- identity / Entra ---
ENABLE_ENTRA_SSO=false                     # [staging][prod] enable Microsoft sign-in
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000          # [vault when enabled]
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=                       # [vault] app secret, rotate on schedule

# --------------------------------------------------------------- key vault ---
AZURE_KEY_VAULT_URI=https://your-vault.vault.azure.net        # [staging][prod]
KEY_VAULT_CACHE_TTL_MS=300000
AZURE_USE_MANAGED_IDENTITY=true            # [prod] preferred; no secret to rotate
AZURE_ALLOW_SERVICE_PRINCIPAL=false        # [prod] set true only to accept the SP risk
# IDENTITY_ENDPOINT / IDENTITY_HEADER are injected by Azure hosting — do not set manually.

# ------------------------------------------------------------------- azure ---
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000    # [staging][prod]
AZURE_RESOURCE_GROUP=rg-skilltrack-labs
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000          # service-principal fallback
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000          # SP app id, or user-assigned MI client id
AZURE_CLIENT_SECRET=                       # [vault] omit when using managed identity
AZURE_VNET_NAME=vnet-skilltrack-labs
AZURE_SUBNET_NAME=snet-labs
LAB_VM_READY_TIMEOUT_MS=600000
AZURE_EVENTGRID_KEY=                       # [vault] shared key for /api/public/events/azure

# --------------------------------------------------------- pool / capacity ---
ENABLE_DYNAMIC_VM_PROVISIONING=false       # pool-only when false
MAX_SESSION_MINUTES=120
MAX_CONCURRENT_SESSIONS_PER_USER=1
DISABLE_SESSION_REAPER=false               # [prod] must stay false
CLOUD_REFRESH_INTERVAL_MS=300000           # cloud inventory refresh cadence

# --------------------------------------------------------------- guacamole ---
DISABLE_REMOTE_DESKTOP=false
GUACAMOLE_URL=http://guacamole:8080/guacamole                 # internal, server-to-server
GUACAMOLE_PUBLIC_URL=https://labs.example.com                 # [prod] must be HTTPS
GUACAMOLE_USERNAME=skilltrack-service
GUACAMOLE_ADMIN_PASSWORD=                  # [vault]
GUACAMOLE_SHARED_SECRET=                   # [vault] signs gateway tokens
GUACAMOLE_DATA_SOURCE=postgresql
GUACAMOLE_REQUEST_TIMEOUT_MS=15000
GUACAMOLE_CONNECT_TIMEOUT_MS=60000

# ------------------------------------------------------------------- rdp ----
LAB_VM_USERNAME=labadmin                   # [vault]
LAB_VM_PASSWORD=                           # [vault]
LAB_VM_DOMAIN=
LAB_RDP_SECURITY=nla                       # nla | tls | rdp | any
LAB_RDP_IGNORE_CERT=true
LAB_CLIPBOARD=readwrite                    # readwrite | readonly | disabled

# ------------------------------------------------------------------ tests ---
CLOUD_MODE=mock                            # [local/CI] never reach real infrastructure
REMOTE_DESKTOP_MODE=simulated

# ------------------------------------------------- agent integrations (MCP) ---
# The MCP server is published at https://<your-host>/mcp and authenticates each
# agent as a real SkillTrack Labs user over OAuth 2.1 — there is no shared API
# key to configure, and no secret belongs in an MCP client config.
MCP_TOOL_GROUPS=all                        # all | catalog,session,lifecycle,diagnostics
MCP_ALLOW_MUTATIONS=true                   # [staging] set false for a read-only agent surface
MCP_RATE_LIMIT=60                          # tool calls per user per window
MCP_RATE_WINDOW_SECONDS=60
# Local development: point the MCP client at http://localhost:8080/mcp and sign
# in through the app; approve the connection on the consent screen.
